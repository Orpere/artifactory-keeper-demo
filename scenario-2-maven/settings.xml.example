<?xml version="1.0" encoding="UTF-8"?>
<!--
  settings.xml — Maven client configuration for Artifact Keeper.

  Copy this file to ~/.m2/settings.xml and fill in your credentials:

    <username>your-artifact-keeper-username</username>
    <password>your-password-or-api-token</password>

  The <server><id> MUST match the <distributionManagement><repository><id>
  in pom.xml (artifact-keeper).

  You can also generate this file automatically with the ak CLI
  (ak setup maven), see docs/04-repositories.md.

  Prefer an API token over your Keycloak password for scripts and CI:
    ak auth token create ci-deploy     # then use the token as <password>
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0 http://maven.apache.org/xsd/settings-1.0.0.xsd">

  <servers>
    <server>
      <id>artifact-keeper</id>
      <username>YOUR_USERNAME</username>
      <password>YOUR_PASSWORD_OR_API_TOKEN</password>
    </server>
  </servers>

  <!--
    Optional: mirror ALL requests through Artifact Keeper, so dependencies
    are resolved from your private registry too (pull-through caching).

    <mirrors>
      <mirror>
        <id>artifact-keeper</id>
        <name>Artifact Keeper</name>
        <url>https://artifact-keeper.devopsexpress.site/maven</url>
        <mirrorOf>*</mirrorOf>
      </mirror>
    </mirrors>
  -->
</settings>
